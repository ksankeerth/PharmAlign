# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Gemini platform configuration (default)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# PharmAlign contract routes (/dossier-reads, /health)
# The server's MCP tools (streamable HTTP). The agent reads documents only through them.
PHARMALIGN_MCP_URL=http://localhost:8000/mcp
# "vertex", "api_key" or "scripted" (follows demo/scripted, no key). Default: api_key if GEMINI_API_KEY is set, else vertex.
# PHARMALIGN_MODEL_MODE=vertex
# Override this agent's model. Default is set in app/agent.py.
# PHARMALIGN_MODEL_DOSSIER_READER=gemini-3.8-flash
# Telemetry goes to Google Cloud only when this is "true". Off by default.
# PHARMALIGN_OTEL_TO_CLOUD=true
# For playing in the ADK playground only: a run token the tools accept.
# PHARMALIGN_DEV_RUN_TOKEN=
