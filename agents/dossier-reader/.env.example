# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Gemini platform configuration (default)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# PharmAlign contract routes (/dossier-reads, /health)
# The token the caller sends as "Authorization: Bearer ...". Postman's local environment uses this value.
AGENT_SERVICE_TOKEN=local-dev-token
# Where the tools find documents locally. Defaults to samples/dossier.
# DOSSIER_DIR=samples/dossier
