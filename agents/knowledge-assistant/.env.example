# Local development configuration. For deployment these are set by the deploy command.

# Gemini through Google Cloud (default)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Or the Gemini API: comment out the three lines above and uncomment
# GEMINI_API_KEY=your-api-key-here

# The server's MCP tools (streamable HTTP). The agent reads only through them.
PHARMALIGN_MCP_URL=http://localhost:8000/mcp
# "vertex", "api_key" or "scripted" (follows demo/scripted, no key). Default: api_key if GEMINI_API_KEY is set, else vertex.
# PHARMALIGN_MODEL_MODE=vertex
# Override this agent's model. Default is MODEL in app/agent.py.
# PHARMALIGN_MODEL_KNOWLEDGE_ASSISTANT=gemini-3.8-flash
# Telemetry goes to Google Cloud only when this is "true". Off by default.
# PHARMALIGN_OTEL_TO_CLOUD=true
# For the ADK playground only: a run token the tools accept.
# PHARMALIGN_DEV_RUN_TOKEN=
